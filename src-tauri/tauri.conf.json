{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReStructura",
  "version": "1.0.1",
  "identifier": "com.restructura.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ReStructura",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Document what is inside your walls",
    "longDescription": "Pin photos, notes and measurements to a floor plan to document pipes, cables and conduit during a renovation. Fully offline; projects export as plain zip files.",
    "category": "Utility",
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
